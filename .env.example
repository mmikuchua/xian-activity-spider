# DeepSeek API 配置示例：复制为 .env 后填入自己的密钥（.env 已被 .gitignore 忽略）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 打标用快模型，顾问/解释用更强模型（可选 deepseek-v4-pro）
DEEPSEEK_TAG_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=deepseek-flash
ENRICH_CONCURRENCY=4

# 服务
PORT=8000
ALLOW_CRAWL=true
CORS_ORIGINS=*
