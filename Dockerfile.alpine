# Dockerfile.alpine - 使用Alpine Linux，完全自包含
FROM alpine:3.19

# 1. 设置阿里云镜像源加速安装，然后安装系统依赖
RUN echo "http://mirrors.aliyun.com/alpine/v3.19/main" > /etc/apk/repositories && \
    echo "http://mirrors.aliyun.com/alpine/v3.19/community" >> /etc/apk/repositories

# 2. 安装基础系统工具、Python、Chromium浏览器及中文字体
RUN apk update && apk add --no-cache \
    python3 \
    py3-pip \
    chromium \
    chromium-chromedriver \
    tzdata \
    font-noto-cjk \
    && ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && pip3 install --upgrade pip

# 3. 设置工作目录
WORKDIR /app

# 4. 复制依赖文件并安装Python包（使用国内镜像加速）
COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 5. 复制应用代码
COPY app_docker.py .
COPY spider_docker.py .

# 6. 创建非root用户运行（安全考虑）
RUN addgroup -g 1000 -S appuser && \
    adduser -u 1000 -S appuser -G appuser && \
    chown -R appuser:appuser /app
USER appuser

# 7. 设置环境变量（告诉Selenium使用我们安装的Chromium）
ENV CHROMIUM_PATH=/usr/bin/chromium-browser
ENV CHROME_DRIVER_PATH=/usr/bin/chromedriver
ENV PYTHONUNBUFFERED=1

# 8. 暴露端口
EXPOSE 8000

# 9. 启动命令
CMD ["python3", "-m", "uvicorn", "app_docker.py:app", "--host", "0.0.0.0", "--port", "8000"]